# WMS Core Environment Configuration
POSTGRES_DB=wms_core
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=wms_secure_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://wms_user:wms_secure_password_change_me@db:5432/wms_core

# Security / JWT
JWT_SECRET_KEY=replace_with_64_char_random_hex_secret_in_production
JWT_REFRESH_SECRET_KEY=replace_with_another_64_char_random_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Regional & Operational Settings
TIMEZONE=Asia/Dushanbe
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Seed initial corporate data on startup (set false in strict prod after init)
AUTO_SEED=true
